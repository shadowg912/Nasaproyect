# Clave privada de NASA FIRMS (gratuita): https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Puede quedar vacía: la app funciona con datos locales y con el feed público de 7 días.
FIRMS_MAP_KEY=

# Ruta del archivo SQLite (almacenamiento local, fuera de public/)
DATABASE_PATH=./data/fuego-rd.sqlite

# Fuentes NRT a sincronizar (separadas por coma)
FIRMS_SOURCES=VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,VIIRS_SNPP_NRT

# Días a consultar en cada sincronización (1..5, límite de la API de área)
FIRMS_DAY_RANGE=2

# Intervalo de sync:watch en minutos
SYNC_INTERVAL_MINUTES=30

# Horas tras las cuales los datos se consideran "almacenados" y no "actualizados"
SYNC_FRESH_HOURS=6

# Tiempo máximo por solicitud a NASA (ms)
FIRMS_TIMEOUT_MS=30000

# Clave de Anthropic para el chat IA (opcional). Vacía = el chat muestra «disponible cuando se configure la clave».
ANTHROPIC_API_KEY=
